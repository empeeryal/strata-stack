# ──────────────────────────────────────────────────────────────────────────────
# Copy to `.env` for local development. Never commit `.env`.
# On Vercel / Netlify / Cloudflare set these in the dashboard (or `wrangler secret put`).
# ──────────────────────────────────────────────────────────────────────────────

# Which platform to build for: node | vercel | cloudflare | netlify
# Auto-detected on Vercel, Netlify and Cloudflare Workers Builds; defaults to node.
DEPLOY_TARGET=node

# Canonical site URL (optional; full URL with https://, no trailing slash). Used for the sitemap,
# RSS, canonical links and OG images. When unset, the production URL injected by Vercel
# (VERCEL_PROJECT_PRODUCTION_URL) or Netlify (URL) is used, then `siteConfig.url`.
SITE_URL=http://localhost:4321

# ── Database (Turso / libSQL) ────────────────────────────────────────────────
# Local development uses a file database (created by `pnpm db:migrate`).
# Production: DATABASE_URL=libsql://<db-name>-<org>.turso.io and DATABASE_AUTH_TOKEN=<token>
# (TURSO_DATABASE_URL and TURSO_AUTH_TOKEN, as set by Turso's Vercel integration, work too.)
DATABASE_URL=file:./.data/local.db
DATABASE_AUTH_TOKEN=

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or: pnpm exec auth secret)
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
# Must match the URL visitors use. Preview URLs on Vercel/Netlify are trusted automatically.
BETTER_AUTH_URL=http://localhost:4321
# Optional comma-separated extra origins (wildcards allowed): https://*.example.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Social login (optional – buttons are hidden when unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Used by magic links, email verification, password resets and contact notifications.
# Unset: in development/test the message is printed to the console; in production
# (NODE_ENV=production) sending fails and these features are hidden instead.
RESEND_API_KEY=
EMAIL_FROM="Strata <noreply@example.com>"
CONTACT_TO_EMAIL=you@example.com

# ── Administration and data retention ────────────────────────────────────────
# Comma-separated addresses that receive the admin role when they sign up.
# Existing accounts: pnpm admin:promote user@example.com
ADMIN_EMAILS=
# Archived contact messages older than this are deleted by `pnpm db:prune`.
CONTACT_RETENTION_DAYS=365
# Optional hard cap: `pnpm db:prune` also deletes messages of ANY status older than this.
# Leave empty to keep open (new/read) messages until they are archived.
CONTACT_MAX_AGE_DAYS=
# Optional: bearer token that unlocks the detailed /api/health response for uptime monitors
# (`Authorization: Bearer <token>`). Administrators see the details with their session.
HEALTH_TOKEN=

# ── Analytics (public, shipped to the browser) ───────────────────────────────
# none | vercel
PUBLIC_ANALYTICS=none
