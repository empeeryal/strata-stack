{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec cross-env HOST=127.0.0.1 PORT=4321 node ./dist/server/entry.mjs",
      "startServerReadyPattern": "Server listening",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/docs/getting-started/introduction",
        "http://127.0.0.1:4321/blog/deploy-anywhere"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
