---
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';
import { desc, eq } from 'drizzle-orm';

import ChangePasswordForm from '@/components/react/account/ChangePasswordForm';
import DeleteAccountForm from '@/components/react/account/DeleteAccountForm';
import VerifyEmailButton from '@/components/react/account/VerifyEmailButton';
import SignOutButton from '@/components/react/auth/SignOutButton';
import Alert from '@/components/ui/Alert.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import { db } from '@/db/client';
import { session as sessionTable } from '@/db/schema';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { describeUserAgent } from '@/lib/account';
import { accountNoticeMessage } from '@/lib/account-page';
import { isAdmin } from '@/lib/admin';
import { auth } from '@/lib/auth';
import { isEmailConfigured } from '@/lib/email';
import { getAuthoritativeSession } from '@/lib/session';
import { formatDate, toISODate } from '@/lib/utils';

export const prerender = false;

// The account page decides access from the database rather than the five-minute cookie
// cache, so a ban or "sign out everywhere" ends access on the next request (and expires the
// stale cookies). The header reads the same fresh values through Astro.locals.
const { user, session } = await getAuthoritativeSession(Astro.request.headers, Astro.cookies);
Astro.locals.user = user;
Astro.locals.session = session;
if (!user || !session) {
  // Verification and magic-link callbacks target this page; forward their error state.
  const error = Astro.url.searchParams.get('error');
  return Astro.redirect(
    `/login?next=/dashboard${error ? `&error=${encodeURIComponent(error)}` : ''}`,
  );
}

const PROVIDER_LABELS: Record<string, string> = {
  credential: 'Password',
  github: 'GitHub',
  google: 'Google',
};

// The session forms post back here; redirect after a success so a refresh never repeats it.
const results = [
  Astro.getActionResult(actions.account.revokeSession),
  Astro.getActionResult(actions.account.revokeOtherSessions),
];
const completed = results.find((result) => result && !result.error);
if (completed) {
  const data = completed.data as { notice?: string } | undefined;
  return Astro.redirect(`/dashboard${data?.notice ? `?notice=${data.notice}` : ''}`);
}
const actionError = results.find((result) => result?.error)?.error?.message ?? null;
const notice = accountNoticeMessage(Astro.url.searchParams.get('notice'));

const [accounts, sessions] = await Promise.all([
  auth.api.listUserAccounts({ headers: Astro.request.headers }),
  db
    .select()
    .from(sessionTable)
    .where(eq(sessionTable.userId, user.id))
    .orderBy(desc(sessionTable.updatedAt)),
]);
const hasPassword = accounts.some((account) => account.providerId === 'credential');
const signInMethods =
  accounts.map((account) => PROVIDER_LABELS[account.providerId] ?? account.providerId).join(', ') ||
  'Magic link';
const emailConfigured = isEmailConfigured();
---

<BaseLayout
  title="Dashboard"
  description="Your account overview."
  noindex
  searchable={false}
  class="container max-w-4xl py-16"
>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold text-primary">Dashboard</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Hello, {user.name}</h1>
      <p class="mt-2 text-muted-foreground">Manage your account, password and data.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {isAdmin(user) && (
        <Button href="/admin" variant="secondary">
          <Icon name="lucide:shield" aria-hidden="true" />
          Admin
        </Button>
      )}
      <SignOutButton client:load />
    </div>
  </header>

  {notice && (
    <Alert variant="success" role="status" class="mt-6" data-account-notice>
      {notice}
    </Alert>
  )}
  {actionError && (
    <Alert class="mt-6" data-account-notice>
      {actionError}
    </Alert>
  )}

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <Card>
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:user" class="size-4 text-primary" aria-hidden="true" />
        Account
      </h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Name</dt>
          <dd class="font-medium">{user.name}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Email</dt>
          <dd class="font-medium">{user.email}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Email verified</dt>
          <dd>
            {user.emailVerified ? (
              <Badge variant="success">Verified</Badge>
            ) : (
              <Badge variant="muted">Not verified</Badge>
            )}
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Sign-in methods</dt>
          <dd class="font-medium">{signInMethods}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Member since</dt>
          <dd>
            <time datetime={toISODate(user.createdAt)}>{formatDate(user.createdAt)}</time>
          </dd>
        </div>
      </dl>
      {!user.emailVerified && (
        <div class="mt-4 border-t pt-4 text-sm">
          {emailConfigured ? (
            <VerifyEmailButton client:load email={user.email} />
          ) : (
            <p class="text-muted-foreground">
              Email verification is unavailable until the site owner configures email delivery.
            </p>
          )}
        </div>
      )}
    </Card>

    <Card>
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:key-round" class="size-4 text-primary" aria-hidden="true" />
        Sessions
      </h2>
      <p class="mt-2 text-sm text-pretty text-muted-foreground">
        Every device where you are signed in. Sign out of any you do not recognise.
      </p>
      <ul class="mt-4 divide-y text-sm" data-sessions>
        {sessions.map((entry) => {
          const current = entry.id === session.id;
          return (
            <li class="flex flex-wrap items-start justify-between gap-3 py-3">
              <div class="min-w-0">
                <p class="font-medium">
                  {describeUserAgent(entry.userAgent)}
                  {current && (
                    <Badge variant="default" class="ml-2 align-middle">
                      This device
                    </Badge>
                  )}
                </p>
                <p class="text-xs text-muted-foreground">
                  {entry.ipAddress ? `${entry.ipAddress} · ` : ''}
                  Signed in{' '}
                  <time datetime={toISODate(entry.createdAt)}>
                    {formatDate(entry.createdAt, { dateStyle: 'medium', timeStyle: 'short' })}
                  </time>
                  {' · '}Expires{' '}
                  <time datetime={toISODate(entry.expiresAt)}>
                    {formatDate(entry.expiresAt, { dateStyle: 'medium' })}
                  </time>
                </p>
              </div>
              {!current && (
                <form method="POST" action={actions.account.revokeSession}>
                  <input type="hidden" name="id" value={entry.id} />
                  <Button type="submit" variant="ghost" size="sm">
                    Sign out
                  </Button>
                </form>
              )}
            </li>
          );
        })}
      </ul>
      {sessions.length > 1 && (
        <form method="POST" action={actions.account.revokeOtherSessions} class="mt-3">
          <Button type="submit" variant="outline" size="sm">
            Sign out of other sessions
          </Button>
        </form>
      )}
      <p class="mt-4 text-xs text-pretty text-muted-foreground">
        Changing your password or deleting your account signs out every other session as well.
      </p>
    </Card>
  </div>

  {hasPassword && (
    <Card class="mt-6">
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:lock" class="size-4 text-primary" aria-hidden="true" />
        Password
      </h2>
      <p class="mt-2 mb-4 text-sm text-muted-foreground">
        Changing your password signs out every other session.
      </p>
      <ChangePasswordForm client:visible />
    </Card>
  )}

  <Card class="mt-6">
    <h2 class="flex items-center gap-2 font-semibold">
      <Icon name="lucide:database" class="size-4 text-primary" aria-hidden="true" />
      Your data
    </h2>
    <p class="mt-2 text-sm text-pretty text-muted-foreground">
      Download everything stored about you as JSON, or delete your account. Contact messages sent
      from a verified address are included in the export and removed with the account.
    </p>
    <div class="mt-4 flex flex-wrap items-start gap-3">
      <Button href="/api/account/export" variant="outline">
        <Icon name="lucide:download" aria-hidden="true" />
        Download my data
      </Button>
      <DeleteAccountForm client:visible hasPassword={hasPassword} />
    </div>
  </Card>
</BaseLayout>
