---
import { Icon } from 'astro-icon/components';

import ChangePasswordForm from '@/components/react/account/ChangePasswordForm';
import DeleteAccountForm from '@/components/react/account/DeleteAccountForm';
import VerifyEmailButton from '@/components/react/account/VerifyEmailButton';
import SignOutButton from '@/components/react/auth/SignOutButton';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isAdmin } from '@/lib/admin';
import { auth } from '@/lib/auth';
import { isEmailConfigured } from '@/lib/email';
import { formatDate, toISODate } from '@/lib/utils';

export const prerender = false;

const { user, session } = Astro.locals;
if (!user || !session) {
  // Verification and magic-link callbacks target this page; forward their error state.
  const error = Astro.url.searchParams.get('error');
  return Astro.redirect(
    `/login?next=/dashboard${error ? `&error=${encodeURIComponent(error)}` : ''}`,
  );
}

const accounts = await auth.api.listUserAccounts({ headers: Astro.request.headers });
const hasPassword = accounts.some((account) => account.providerId === 'credential');
const providers = accounts.map((account) => account.providerId).filter((id) => id !== 'credential');
const emailConfigured = isEmailConfigured();
const admin = isAdmin(user);
---

<BaseLayout
  title="Dashboard"
  description="Your account overview."
  noindex
  searchable={false}
  class="container max-w-4xl py-16"
>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold text-primary">Dashboard</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Hello, {user.name}</h1>
      <p class="mt-2 text-muted-foreground">
        This page is rendered on the server for every request and only for signed-in users.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {admin && (
        <Button href="/admin" variant="secondary">
          <Icon name="lucide:shield" aria-hidden="true" />
          Admin
        </Button>
      )}
      <SignOutButton client:load />
    </div>
  </header>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    <Card>
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:user" class="size-4 text-primary" aria-hidden="true" />
        Account
      </h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Name</dt>
          <dd class="font-medium">{user.name}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Email</dt>
          <dd class="font-medium">{user.email}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Email verified</dt>
          <dd>
            {user.emailVerified ? (
              <Badge variant="success">Verified</Badge>
            ) : (
              <Badge variant="muted">Not verified</Badge>
            )}
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Sign-in methods</dt>
          <dd class="font-medium">
            {[hasPassword ? 'password' : null, ...providers].filter(Boolean).join(', ') ||
              'magic link'}
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Member since</dt>
          <dd>
            <time datetime={toISODate(user.createdAt)}>{formatDate(user.createdAt)}</time>
          </dd>
        </div>
      </dl>
      {!user.emailVerified && (
        <div class="mt-4 border-t pt-4 text-sm">
          {emailConfigured ? (
            <VerifyEmailButton client:load email={user.email} />
          ) : (
            <p class="text-muted-foreground">
              Email verification is unavailable until the site owner configures email delivery.
            </p>
          )}
        </div>
      )}
    </Card>

    <Card>
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:key-round" class="size-4 text-primary" aria-hidden="true" />
        Session
      </h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Expires</dt>
          <dd>
            <time datetime={toISODate(session.expiresAt)}>
              {formatDate(session.expiresAt, { dateStyle: 'medium', timeStyle: 'short' })}
            </time>
          </dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted-foreground">Rendered on</dt>
          <dd class="font-mono text-xs">{__DEPLOY_TARGET__}</dd>
        </div>
      </dl>
      <p class="mt-4 text-xs text-pretty text-muted-foreground">
        Sessions are stored in the database by Better Auth and cached in a signed cookie for five
        minutes to avoid a database read on every request.
      </p>
    </Card>
  </div>

  {hasPassword && (
    <Card class="mt-6">
      <h2 class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:lock" class="size-4 text-primary" aria-hidden="true" />
        Password
      </h2>
      <p class="mt-2 mb-4 text-sm text-muted-foreground">
        Changing your password signs out every other session.
      </p>
      <ChangePasswordForm client:visible />
    </Card>
  )}

  <Card class="mt-6">
    <h2 class="flex items-center gap-2 font-semibold">
      <Icon name="lucide:database" class="size-4 text-primary" aria-hidden="true" />
      Your data
    </h2>
    <p class="mt-2 text-sm text-pretty text-muted-foreground">
      Download everything stored about you as JSON, or delete your account. Contact messages sent
      from a verified address are included in the export and removed with the account.
    </p>
    <div class="mt-4 flex flex-wrap items-start gap-3">
      <Button href="/api/account/export" variant="outline">
        <Icon name="lucide:download" aria-hidden="true" />
        Download my data
      </Button>
      <DeleteAccountForm client:visible hasPassword={hasPassword} />
    </div>
  </Card>

  <Card class="mt-6">
    <h2 class="font-semibold">How this route is protected</h2>
    <p class="mt-2 text-sm text-pretty text-muted-foreground">
      <code class="font-mono">src/middleware.ts</code> resolves the session for every on-demand
      request and stores it in <code class="font-mono">Astro.locals</code>. This page opts out of
      prerendering and redirects to <code class="font-mono">/login</code> when no user is present.
      Because the check lives in the page itself, it cannot be bypassed with an unusual URL encoding
      of the path.
    </p>
  </Card>
</BaseLayout>
