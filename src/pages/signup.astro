---
import AuthForm from '@/components/react/auth/AuthForm';
import SocialButtons from '@/components/react/auth/SocialButtons';
import Divider from '@/components/ui/Divider.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { enabledAuthMethods } from '@/lib/auth';
import { safeRedirectPath } from '@/lib/redirect';

export const prerender = false;

const redirectTo = safeRedirectPath(Astro.url.searchParams.get('next'), '/dashboard');

if (Astro.locals.user) {
  return Astro.redirect(redirectTo);
}

const methods = enabledAuthMethods();
const subheading =
  methods.social.length > 0
    ? 'Use your email and a password, or continue with a connected account.'
    : 'Use your email and a password.';
const nextQuery = redirectTo !== '/dashboard' ? `?next=${encodeURIComponent(redirectTo)}` : '';
---

<AuthLayout
  title="Create an account"
  description="Create an account to access the dashboard."
  heading="Create your account"
  subheading={subheading}
>
  <div class="space-y-6">
    <AuthForm client:load mode="signup" redirectTo={redirectTo} />
    {methods.social.length > 0 && (
      <>
        <Divider label="or" />
        <SocialButtons client:load providers={methods.social} redirectTo={redirectTo} />
      </>
    )}
  </div>
  <Fragment slot="footer">
    Already have an account?{' '}
    <a href={`/login${nextQuery}`} class="font-medium text-foreground underline underline-offset-4">
      Sign in
    </a>
  </Fragment>
</AuthLayout>
