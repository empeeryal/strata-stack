---
import ForgotPasswordForm from '@/components/react/auth/ForgotPasswordForm';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { enabledAuthMethods } from '@/lib/auth';

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}

const { passwordReset } = enabledAuthMethods();
---

<AuthLayout
  title="Forgot password"
  description="Request a link to reset your password."
  heading="Reset your password"
  subheading="Enter your email and we will send you a link to choose a new password."
>
  {passwordReset ? (
    <ForgotPasswordForm client:load />
  ) : (
    <p role="status" class="text-sm text-muted-foreground">
      Password reset by email is not available on this deployment because no email provider is
      configured. Contact the site owner to regain access to your account.
    </p>
  )}
  <Fragment slot="footer">
    <a href="/login" class="font-medium text-foreground underline underline-offset-4">
      Back to sign in
    </a>
  </Fragment>
</AuthLayout>
