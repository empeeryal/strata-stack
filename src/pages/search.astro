---
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search the documentation, blog and changelog."
  searchable={false}
  noindex
  class="container max-w-3xl py-16"
>
  <p class="text-sm font-semibold text-primary">Search</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Find anything on the site</h1>
  <p class="mt-4 text-pretty text-muted-foreground">
    Results come from a static Pagefind index generated at build time, so search works without a
    server on every platform.
  </p>
  <PagefindConfig />
  {/* The region keeps its height before results arrive, so filling it does not move the
      footer while it is on screen (that movement is what Lighthouse counts as layout shift). */}
  <search class="mt-8 flex min-h-[70vh] flex-col gap-6" aria-label="Site search">
    <pagefind-input placeholder="Search docs, blog and changelog…"></pagefind-input>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </search>
</BaseLayout>

<script>
  // Support `/search?q=term` (used by the WebSite JSON-LD SearchAction).
  const term = new URLSearchParams(location.search).get('q');
  if (term) {
    customElements.whenDefined('pagefind-input').then(() => {
      const input = document.querySelector<HTMLInputElement>('pagefind-input input');
      if (!input) return;
      input.value = term;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }
</script>
