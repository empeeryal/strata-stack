---
import { and, count, desc, eq, gte, isNotNull, ne } from 'drizzle-orm';

import Badge from '@/components/ui/Badge.astro';
import BarChart from '@/components/ui/BarChart.astro';
import Card from '@/components/ui/Card.astro';
import { db } from '@/db/client';
import { auditLog, contactMessages, newsletterSubscribers, user as userTable } from '@/db/schema';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { countActiveAdmins } from '@/lib/admin';
import { guardAdminPage } from '@/lib/admin-page';
import { dailyCounts } from '@/lib/chart';
import { isEmailConfigured } from '@/lib/email';
import { getEnv } from '@/lib/env';
import { formatDate, toISODate } from '@/lib/utils';
import { siteConfig } from '@/site.config';

export const prerender = false;

const denied = await guardAdminPage(Astro);
if (denied) return denied;

const CHART_DAYS = 30;
const chartSince = new Date(Date.now() - CHART_DAYS * 86_400_000);

const [
  [users],
  admins,
  messageCounts,
  [failedDeliveries],
  recentMessages,
  recentAudit,
  recentArrivals,
  [subscribers],
  [audienceFailures],
] = await Promise.all([
  db.select({ value: count() }).from(userTable),
  countActiveAdmins(db),
  db
    .select({ status: contactMessages.status, value: count() })
    .from(contactMessages)
    .groupBy(contactMessages.status),
  db
    .select({ value: count() })
    .from(contactMessages)
    .where(eq(contactMessages.deliveryStatus, 'failed')),
  db.select().from(contactMessages).orderBy(desc(contactMessages.createdAt)).limit(5),
  db.select().from(auditLog).orderBy(desc(auditLog.createdAt)).limit(5),
  db
    .select({ createdAt: contactMessages.createdAt })
    .from(contactMessages)
    .where(gte(contactMessages.createdAt, chartSince)),
  db
    .select({ value: count() })
    .from(newsletterSubscribers)
    .where(eq(newsletterSubscribers.status, 'confirmed')),
  db
    .select({ value: count() })
    .from(newsletterSubscribers)
    .where(
      and(
        isNotNull(newsletterSubscribers.audienceError),
        ne(newsletterSubscribers.status, 'pending'),
      ),
    ),
]);
const unsynced = audienceFailures?.value ?? 0;

const messagesPerDay = dailyCounts(
  recentArrivals.map((row) => row.createdAt),
  CHART_DAYS,
);

const messagesByStatus = Object.fromEntries(messageCounts.map((row) => [row.status, row.value]));
const stats = [
  { label: 'Users', value: users?.value ?? 0, href: '/admin/users' },
  { label: 'Administrators', value: admins, href: '/admin/users' },
  { label: 'New messages', value: messagesByStatus.new ?? 0, href: '/admin/messages?status=new' },
  {
    label: 'Failed notifications',
    value: failedDeliveries?.value ?? 0,
    href: '/admin/messages?delivery=failed',
  },
  { label: 'Subscribers', value: subscribers?.value ?? 0, href: '/admin/subscribers' },
];

const recipient = getEnv('CONTACT_TO_EMAIL');
const audienceId = getEnv('RESEND_AUDIENCE_ID');
const webhookSecret = getEnv('RESEND_WEBHOOK_SECRET');
const configuration = [
  {
    label: 'Email delivery',
    ok: isEmailConfigured(),
    detail: isEmailConfigured()
      ? 'Resend is configured: magic links, verification and password resets work.'
      : 'RESEND_API_KEY is not set. Magic links, verification and password resets are unavailable.',
  },
  {
    label: 'Contact notifications',
    ok: Boolean(recipient),
    detail: recipient
      ? `New messages are forwarded to ${recipient}.`
      : 'CONTACT_TO_EMAIL is not set. Messages are only visible in this inbox.',
  },
  ...(siteConfig.newsletter.enabled
    ? [
        {
          label: 'Newsletter audience',
          ok: Boolean(audienceId && isEmailConfigured()) && unsynced === 0,
          detail:
            audienceId && isEmailConfigured()
              ? unsynced > 0
                ? `${unsynced} address${unsynced === 1 ? '' : 'es'} could not be synced to the Resend audience; the subscribers page lists them in the Audience column and the weekly prune job retries them.`
                : 'Confirmed subscribers are mirrored to the Resend audience for sending.'
              : unsynced > 0
                ? `RESEND_AUDIENCE_ID is not set, and ${unsynced} address${unsynced === 1 ? '' : 'es'} from an earlier configuration still need${unsynced === 1 ? 's' : ''} the provider; remove them from the subscribers page if the audience is no longer used.`
                : 'RESEND_AUDIENCE_ID is not set. Subscribers are stored here only; download them as CSV from the subscribers page.',
        },
        ...(audienceId && isEmailConfigured()
          ? [
              {
                label: 'Newsletter webhook',
                ok: Boolean(webhookSecret),
                detail: webhookSecret
                  ? 'Unsubscribes made through Resend are written back to the subscriber list.'
                  : 'RESEND_WEBHOOK_SECRET is not set. Unsubscribes made through Resend broadcasts stay at the provider; add the contact webhook to keep the list in sync.',
              },
            ]
          : []),
      ]
    : []),
];
---

<AdminLayout title="Overview" description="Site administration overview.">
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {stats.map((stat) => (
      <li>
        <a
          href={stat.href}
          class="block rounded-xl border bg-card p-5 shadow-soft transition-colors hover:bg-muted/50"
        >
          <span class="block text-sm text-muted-foreground">{stat.label}</span>
          <span class="mt-1 block text-3xl font-bold tracking-tight">{stat.value}</span>
        </a>
      </li>
    ))}
  </ul>

  <Card class="mt-6">
    <BarChart
      data={messagesPerDay}
      title={`Messages received per day, last ${CHART_DAYS} days`}
      unit="messages"
    />
  </Card>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <Card>
      <h2 class="font-semibold">Configuration</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {configuration.map((item) => (
          <li class="flex items-start gap-3">
            <Badge variant={item.ok ? 'success' : 'muted'}>{item.ok ? 'OK' : 'Off'}</Badge>
            <div>
              <p class="font-medium">{item.label}</p>
              <p class="text-muted-foreground">{item.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </Card>

    <Card>
      <h2 class="font-semibold">Latest messages</h2>
      {recentMessages.length === 0 ? (
        <p class="mt-4 text-sm text-muted-foreground">No messages yet.</p>
      ) : (
        <ul class="mt-4 divide-y text-sm">
          {recentMessages.map((message) => (
            <li class="flex items-center justify-between gap-3 py-2">
              <a
                href={`/admin/messages/${message.id}`}
                data-astro-prefetch="false"
                class="min-w-0 truncate font-medium hover:underline"
              >
                {message.name}
                <span class="font-normal text-muted-foreground"> · {message.email}</span>
              </a>
              <time
                datetime={toISODate(message.createdAt)}
                class="shrink-0 text-xs text-muted-foreground"
              >
                {formatDate(message.createdAt)}
              </time>
            </li>
          ))}
        </ul>
      )}
    </Card>
  </div>

  <Card class="mt-6">
    <h2 class="font-semibold">Recent activity</h2>
    {recentAudit.length === 0 ? (
      <p class="mt-4 text-sm text-muted-foreground">Nothing recorded yet.</p>
    ) : (
      <ul class="mt-4 divide-y text-sm">
        {recentAudit.map((entry) => (
          <li class="flex flex-wrap items-center justify-between gap-3 py-2">
            <span>
              <code class="font-mono text-xs">{entry.action}</code>
              <span class="text-muted-foreground"> by {entry.actorEmail ?? 'system'}</span>
            </span>
            <time datetime={toISODate(entry.createdAt)} class="text-xs text-muted-foreground">
              {formatDate(entry.createdAt, { dateStyle: 'medium', timeStyle: 'short' })}
            </time>
          </li>
        ))}
      </ul>
    )}
    <a
      href="/admin/audit"
      class="mt-4 inline-block text-sm font-medium underline underline-offset-4"
    >
      View the audit log
    </a>
  </Card>
</AdminLayout>
