---
import ResetPasswordForm from '@/components/react/auth/ResetPasswordForm';
import Alert from '@/components/ui/Alert.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';

export const prerender = false;

// Better Auth redirects here with `?token=` from the email, or `?error=INVALID_TOKEN`.
const token = Astro.url.searchParams.get('token');
const error = Astro.url.searchParams.get('error');
---

<AuthLayout
  title="Choose a new password"
  description="Set a new password for your account."
  heading="Choose a new password"
>
  {token && !error ? (
    <ResetPasswordForm client:load token={token} />
  ) : (
    <div class="space-y-3 text-sm">
      <Alert>This reset link is invalid or has expired.</Alert>
      <a href="/forgot-password" class="font-medium text-foreground underline underline-offset-4">
        Request a new link
      </a>
    </div>
  )}
  <Fragment slot="footer">
    <a href="/login" class="font-medium text-foreground underline underline-offset-4">
      Back to sign in
    </a>
  </Fragment>
</AuthLayout>
