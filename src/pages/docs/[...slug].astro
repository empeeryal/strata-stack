---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import { mdxComponents } from '@/components/content/mdx-components';
import { defaultLocale } from '@/i18n';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { docsLocaleOf } from '@/lib/docs';

export async function getStaticPaths() {
  // Translated folders (src/content/docs/<locale>/…) get their own routes under /<locale>/docs.
  const entries = await getCollection(
    'docs',
    (entry) =>
      docsLocaleOf(entry) === defaultLocale && (import.meta.env.PROD ? !entry.data.draft : true),
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</DocsLayout>
