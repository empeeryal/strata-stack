---
import AuthForm from '@/components/react/auth/AuthForm';
import MagicLinkForm from '@/components/react/auth/MagicLinkForm';
import SocialButtons from '@/components/react/auth/SocialButtons';
import Alert from '@/components/ui/Alert.astro';
import Divider from '@/components/ui/Divider.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { enabledAuthMethods } from '@/lib/auth';
import { safeRedirectPath } from '@/lib/redirect';

export const prerender = false;

const redirectTo = safeRedirectPath(Astro.url.searchParams.get('next'), '/dashboard');

if (Astro.locals.user) {
  return Astro.redirect(redirectTo);
}

const methods = enabledAuthMethods();
// Verification and magic-link callbacks land here with `?error=` when a link is bad.
const linkError = Astro.url.searchParams.get('error');

const ways = ['your email and password'];
if (methods.magicLink) ways.push('a magic link');
if (methods.social.length > 0) ways.push('a connected account');
const subheading =
  ways.length === 1
    ? `Sign in with ${ways[0]}.`
    : `Sign in with ${ways.slice(0, -1).join(', ')} or ${ways.at(-1)}.`;
const nextQuery = redirectTo !== '/dashboard' ? `?next=${encodeURIComponent(redirectTo)}` : '';
---

<AuthLayout
  title="Sign in"
  description="Sign in to your account."
  heading="Welcome back"
  subheading={subheading}
>
  <div class="space-y-6">
    {linkError && (
      <Alert>That link is invalid or has expired. Sign in again or request a new one.</Alert>
    )}
    <AuthForm
      client:load
      mode="login"
      redirectTo={redirectTo}
      passwordReset={methods.passwordReset}
    />
    {methods.magicLink && (
      <>
        <Divider label="or" />
        <MagicLinkForm client:load redirectTo={redirectTo} />
      </>
    )}
    {methods.social.length > 0 && (
      <>
        <Divider label="or" />
        <SocialButtons client:load providers={methods.social} redirectTo={redirectTo} />
      </>
    )}
  </div>
  <Fragment slot="footer">
    New here?{' '}
    <a
      href={`/signup${nextQuery}`}
      class="font-medium text-foreground underline underline-offset-4"
    >
      Create an account
    </a>
  </Fragment>
</AuthLayout>
