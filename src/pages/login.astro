---
import AuthForm from '@/components/react/auth/AuthForm';
import MagicLinkForm from '@/components/react/auth/MagicLinkForm';
import SocialButtons from '@/components/react/auth/SocialButtons';
import Alert from '@/components/ui/Alert.astro';
import Divider from '@/components/ui/Divider.astro';
import AuthLayout from '@/layouts/AuthLayout.astro';
import { enabledAuthMethods } from '@/lib/auth';
import { safeRedirectPath } from '@/lib/redirect';
import { getAuthoritativeSession } from '@/lib/session';

export const prerender = false;

const redirectTo = safeRedirectPath(Astro.url.searchParams.get('next'), '/dashboard');

// Sending a signed-in visitor on is an access decision: confirm the cached session against
// the database so a cookie left over from "sign out everywhere" shows the form instead of
// bouncing to the dashboard (which would send it straight back here).
const signedIn = Astro.locals.user
  ? (await getAuthoritativeSession(Astro.request.headers, Astro.cookies)).user
  : null;
if (signedIn) {
  return Astro.redirect(redirectTo);
}
Astro.locals.user = null;
Astro.locals.session = null;

const methods = enabledAuthMethods();
// Verification and magic-link callbacks land here with `?error=` when a link is bad, and the
// OAuth callback (via the dashboard) with the provider's or Better Auth's error code. The visitor
// clicked a button in the second case, so "that link" would be the wrong explanation.
const errorCode = Astro.url.searchParams.get('error')?.toLowerCase() ?? null;
const ERROR_MESSAGES: Record<string, string> = {
  // Better Auth's OAuth callback codes (better-auth/oauth2/errors) and the provider's own.
  email_not_verified:
    'An account with that email address exists but the address is not verified yet. Sign in with your password and verify it first.',
  email_not_found: 'The provider did not share an email address. Use another way to sign in.',
  email_does_not_match:
    'The provider reported a different email address than the account you are connecting.',
  unable_to_link_account: 'That provider account cannot be connected to this account.',
  account_already_linked_to_different_user:
    'That provider account is already connected to another account here.',
  access_denied: 'The provider did not grant access. Try again, or use another way to sign in.',
  user_not_found: 'No account matches that sign-in. Create one first.',
};
const linkError = errorCode
  ? (ERROR_MESSAGES[errorCode] ??
    (/token|expired|invalid_callback|state_/.test(errorCode)
      ? 'That link is invalid or has expired. Sign in again or request a new one.'
      : 'Sign-in could not be completed. Try again, or use another way to sign in.'))
  : null;
// The verification link lands here (it does not sign in, see src/lib/auth.ts).
const verified = Astro.url.searchParams.get('verified') === '1';

const ways = ['your email and password'];
if (methods.magicLink) ways.push('a magic link');
if (methods.social.length > 0) ways.push('a connected account');
const subheading =
  ways.length === 1
    ? `Sign in with ${ways[0]}.`
    : `Sign in with ${ways.slice(0, -1).join(', ')} or ${ways.at(-1)}.`;
const nextQuery = redirectTo !== '/dashboard' ? `?next=${encodeURIComponent(redirectTo)}` : '';
---

<AuthLayout
  title="Sign in"
  description="Sign in to your account."
  heading="Welcome back"
  subheading={subheading}
>
  <div class="space-y-6">
    {linkError && <Alert>{linkError}</Alert>}
    {verified && !linkError && (
      <Alert variant="success">
        Your email address is verified. Sign in to continue. If you did not create this account, use{' '}
        <a href="/forgot-password" class="font-medium underline underline-offset-4">
          Forgot password
        </a>{' '}
        to make it yours.
      </Alert>
    )}
    <AuthForm
      client:load
      mode="login"
      redirectTo={redirectTo}
      passwordReset={methods.passwordReset}
    />
    {methods.magicLink && (
      <>
        <Divider label="or" />
        <MagicLinkForm client:idle redirectTo={redirectTo} />
      </>
    )}
    {methods.social.length > 0 && (
      <>
        <Divider label="or" />
        <SocialButtons client:idle providers={methods.social} redirectTo={redirectTo} />
      </>
    )}
  </div>
  <Fragment slot="footer">
    New here?{' '}
    <a
      href={`/signup${nextQuery}`}
      class="font-medium text-foreground underline underline-offset-4"
    >
      Create an account
    </a>
  </Fragment>
</AuthLayout>
