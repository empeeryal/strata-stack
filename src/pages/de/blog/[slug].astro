---
import { type CollectionEntry, render } from 'astro:content';

import { mdxComponents } from '@/components/content/mdx-components';
import type { Locale } from '@/i18n';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { getAllPublishedPosts, postAlternates, postLocale, postSlug } from '@/lib/content';

export async function getStaticPaths() {
  const all = await getAllPublishedPosts();
  return all
    .filter((post) => postLocale(post) === 'de')
    .map((post) => ({
      params: { slug: postSlug(post) },
      props: { post, alternates: postAlternates(post, all) },
    }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  alternates: Partial<Record<Locale, string>>;
}

const { post, alternates } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout post={post} headings={headings} alternates={alternates}>
  <Content components={mdxComponents} />
</BlogPostLayout>
