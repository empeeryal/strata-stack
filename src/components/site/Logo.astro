---
interface Props {
  /** Unique per instance on a page: the gradient is referenced by id. */
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
const gradientId = `logo-${id}-gradient`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--color-primary)"></stop>
      <stop offset="1" stop-color="var(--color-accent)"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill={`url(#${gradientId})`}></rect>
  <path d="M32 11l5.6 15.4L53 32l-15.4 5.6L32 53l-5.6-15.4L11 32l15.4-5.6z" fill="#fff"></path>
</svg>
