---
interface Props {
  class?: string;
}
const { class: className = 'size-8' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="logo-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6d5dfc"></stop>
      <stop offset="1" stop-color="#22c1c3"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill="url(#logo-gradient)"></rect>
  <path d="M32 11l5.6 15.4L53 32l-15.4 5.6L32 53l-5.6-15.4L11 32l15.4-5.6z" fill="#fff"></path>
</svg>
