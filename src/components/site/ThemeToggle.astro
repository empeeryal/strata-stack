---
import { Icon } from 'astro-icon/components';

import { buttonVariants } from '@/components/ui/button-variants';
import { resolveLocale, useTranslations } from '@/i18n';

const t = useTranslations(resolveLocale(Astro.currentLocale));
---

<theme-toggle
  class="contents"
  data-label-dark={t('theme.toDark')}
  data-label-light={t('theme.toLight')}
>
  <button
    type="button"
    class={buttonVariants({ variant: 'ghost', size: 'icon' })}
    aria-label={t('theme.switch')}
    title={t('theme.switch')}
  >
    <Icon name="lucide:sun" class="theme-icon-light size-5" aria-hidden="true" />
    <Icon name="lucide:moon" class="theme-icon-dark size-5" aria-hidden="true" />
  </button>
</theme-toggle>

<style>
  :global([data-theme='dark']) .theme-icon-light,
  :global(:root:not([data-theme='dark'])) .theme-icon-dark {
    display: none;
  }
</style>

<script>
  import { trackEvent } from '@/lib/analytics';
  import { THEME_STORAGE_KEY } from '@/lib/theme-script';

  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');

  function apply(theme: Theme, preference: Theme | 'system') {
    root.dataset.theme = theme;
    root.dataset.themePreference = preference;
    root.style.colorScheme = theme;
  }

  // Follow OS changes while no explicit choice has been made.
  media.addEventListener('change', (event) => {
    if (root.dataset.themePreference === 'system') {
      apply(event.matches ? 'dark' : 'light', 'system');
    }
  });

  /** Names the action the button will perform, not the current state; the text comes from the locale. */
  function label(toggle: HTMLElement, button: HTMLButtonElement) {
    const text =
      root.dataset.theme === 'dark'
        ? (toggle.dataset.labelLight ?? 'Switch to light theme')
        : (toggle.dataset.labelDark ?? 'Switch to dark theme');
    button.setAttribute('aria-label', text);
    button.title = text;
  }

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      if (!button) return;
      label(this, button);
      media.addEventListener('change', () => label(this, button));
      button.addEventListener('click', () => {
        const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        apply(next, next);
        trackEvent('Theme changed', { theme: next });
        label(this, button);
        try {
          localStorage.setItem(THEME_STORAGE_KEY, next);
        } catch {
          /* storage unavailable */
        }
      });
    }
  }

  if (!customElements.get('theme-toggle')) {
    customElements.define('theme-toggle', ThemeToggle);
  }
</script>
