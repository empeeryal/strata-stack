---
import { Icon } from 'astro-icon/components';

import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import { type Locale, defaultLocale, intlLocales, localeNames, useTranslations } from '@/i18n';
import {
  type BlogPost,
  getReadingMinutes,
  postHref,
  postLocale,
  postOgImage,
  tagHref,
} from '@/lib/content';
import { formatDate, toISODate } from '@/lib/utils';

interface Props {
  post: BlogPost;
  /** Locale of the page showing the card; defaults to the post's own. */
  locale?: Locale;
  /** Load the image eagerly for above-the-fold cards. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const locale = Astro.props.locale ?? postLocale(post);
const t = useTranslations(locale);
const href = postHref(post);
const own = postLocale(post);
// A post in another language than the page (an untranslated English post on /de/blog) says so.
const foreign = own !== locale;
// Tag pages exist for the default locale only.
const linkTags = locale === defaultLocale && own === defaultLocale;
---

<Card as="li" interactive class="flex flex-col overflow-hidden p-0">
  <a href={href} tabindex="-1" aria-hidden="true" class="block aspect-[1200/630] bg-muted">
    <img
      src={postOgImage(post)}
      alt=""
      width="1200"
      height="630"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="size-full object-cover"
    />
  </a>
  <div class="flex flex-1 flex-col p-6" lang={foreign ? own : undefined}>
    <div class="flex flex-wrap gap-2">
      {foreign && <Badge variant="outline">{localeNames[own]}</Badge>}
      {post.data.tags.slice(0, 3).map((tag) =>
        linkTags ? (
          <Badge variant="secondary" href={tagHref(tag)}>
            {tag}
          </Badge>
        ) : (
          <Badge variant="secondary">{tag}</Badge>
        ),
      )}
    </div>
    <h2 class="mt-3 text-lg font-semibold text-balance">
      <a href={href} class="hover:text-primary">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-2 line-clamp-3 text-sm text-pretty text-muted-foreground">
      {post.data.description}
    </p>
    <p class="mt-auto flex items-center gap-3 pt-4 text-xs text-muted-foreground">
      <time datetime={toISODate(post.data.pubDate)}>
        {formatDate(post.data.pubDate, undefined, intlLocales[locale])}
      </time>
      <span class="flex items-center gap-1">
        <Icon name="lucide:clock" class="size-3.5" aria-hidden="true" />
        {t('blog.readingTime', { minutes: getReadingMinutes(post.body) })}
      </span>
    </p>
  </div>
</Card>
