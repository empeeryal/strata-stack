---
import { Icon } from 'astro-icon/components';

import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import { type BlogPost, getReadingTime, postHref, postOgImage, tagHref } from '@/lib/content';
import { formatDate, toISODate } from '@/lib/utils';

interface Props {
  post: BlogPost;
  /** Load the image eagerly for above-the-fold cards. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const href = postHref(post);
---

<Card as="li" interactive class="flex flex-col overflow-hidden p-0">
  <a href={href} tabindex="-1" aria-hidden="true" class="block aspect-[1200/630] bg-muted">
    <img
      src={postOgImage(post)}
      alt=""
      width="1200"
      height="630"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="size-full object-cover"
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap gap-2">
      {post.data.tags.slice(0, 3).map((tag) => (
        <Badge variant="secondary" href={tagHref(tag)}>
          {tag}
        </Badge>
      ))}
    </div>
    <h2 class="mt-3 text-lg font-semibold text-balance">
      <a href={href} class="hover:text-primary">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-2 line-clamp-3 text-sm text-pretty text-muted-foreground">
      {post.data.description}
    </p>
    <p class="mt-auto flex items-center gap-3 pt-4 text-xs text-muted-foreground">
      <time datetime={toISODate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
      <span class="flex items-center gap-1">
        <Icon name="lucide:clock" class="size-3.5" aria-hidden="true" />
        {getReadingTime(post.body)}
      </span>
    </p>
  </div>
</Card>
