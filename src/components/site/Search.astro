---
/**
 * Header search trigger and the command palette island behind it. The triggers are plain links
 * to `/search`, so visitors without JavaScript still reach the results page; once the island
 * hydrates it intercepts them (and Ctrl/⌘+K) and opens the palette instead.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import CommandPalette, { type PaletteLink } from '@/components/react/CommandPalette';
import Kbd from '@/components/ui/Kbd.astro';
import { buttonVariants } from '@/components/ui/button-variants';
import { buildDocsTree } from '@/lib/docs';
import { cn } from '@/lib/utils';
import { siteConfig } from '@/site.config';

const pages: PaletteLink[] = [
  ...siteConfig.nav.map((item) => ({ label: item.label, href: item.href, group: 'Pages' })),
  { label: 'Contact', href: '/contact', group: 'Pages' },
  { label: 'Privacy policy', href: '/legal/privacy', group: 'Pages' },
  { label: 'Terms of service', href: '/legal/terms', group: 'Pages' },
];

const docs: PaletteLink[] = buildDocsTree(await getCollection('docs')).flatMap((section) =>
  section.items.map((item) => ({
    label: item.title,
    href: item.href,
    group: `Docs · ${section.label}`,
    keywords: item.description,
  })),
);
---

<search-trigger class="contents">
  <a
    href="/search"
    data-palette-trigger
    class={cn(
      buttonVariants({ variant: 'outline', size: 'sm' }),
      'hidden w-56 justify-between text-muted-foreground md:flex',
    )}
    aria-label="Search the site"
  >
    <span class="flex items-center gap-2">
      <Icon name="lucide:search" aria-hidden="true" />
      Search…
    </span>
    <span class="flex gap-1">
      <Kbd>
        <span data-modifier>Ctrl</span>
      </Kbd>
      <Kbd>K</Kbd>
    </span>
  </a>
  <a
    href="/search"
    data-palette-trigger
    class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'md:hidden')}
    aria-label="Search the site"
  >
    <Icon name="lucide:search" class="size-5" aria-hidden="true" />
  </a>
</search-trigger>

<CommandPalette client:idle links={[...pages, ...docs]} />

<script>
  class SearchTrigger extends HTMLElement {
    connectedCallback() {
      // `navigator.platform` is deprecated; use the User-Agent Client Hints value when present.
      const platform =
        (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData
          ?.platform ?? navigator.platform;
      if (/Mac|iPhone|iPad|iOS/.test(platform)) {
        const modifier = this.querySelector('[data-modifier]');
        if (modifier) modifier.textContent = '⌘';
      }
    }
  }

  if (!customElements.get('search-trigger')) {
    customElements.define('search-trigger', SearchTrigger);
  }
</script>
