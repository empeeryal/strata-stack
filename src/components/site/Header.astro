---
import { labelFor, localizeHref, resolveLocale, useTranslations } from '@/i18n';
import { siteConfig } from '@/site.config';

import AccountMenu from './AccountMenu.astro';
import GitHubLink from './GitHubLink.astro';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const nav = siteConfig.nav.map((item) => ({
  href: localizeHref(item.href, locale),
  label: labelFor(locale, item.href, item.label),
}));
---

<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70">
  <div class="container flex h-16 items-center gap-4">
    <a
      href={localizeHref('/', locale)}
      class="mr-2 flex items-center gap-2 font-semibold"
      aria-label={t('header.home')}
    >
      <Logo id="header" class="size-7" />
      <span class="hidden sm:inline">{siteConfig.name}</span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <Search />
      <GitHubLink />
      <ThemeToggle />
      <AccountMenu placement="header" />
      <MobileNav />
    </div>
  </div>
</header>
