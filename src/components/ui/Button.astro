---
import type { HTMLAttributes } from 'astro/types';

import { cn } from '@/lib/utils';

import { buttonVariants, type ButtonVariantProps } from './button-variants';

type Props = ButtonVariantProps & {
  class?: string;
  /** Render an anchor instead of a button. */
  href?: string;
  /** Open `href` in a new tab with safe rel attributes. */
  external?: boolean;
} & (HTMLAttributes<'a'> | HTMLAttributes<'button'>);

const { variant, size, href, external = false, class: className, ...rest } = Astro.props;
const classes = cn(buttonVariants({ variant, size }), className);
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class={classes} {...externalAttrs} {...(rest as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}
