---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<kbd
  class={cn(
    'inline-flex h-5 min-w-5 items-center justify-center rounded border bg-muted px-1.5 font-mono text-[11px] font-medium text-muted-foreground',
    className,
  )}
>
  <slot />
</kbd>
