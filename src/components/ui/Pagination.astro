---
import { Icon } from 'astro-icon/components';

import { cn } from '@/lib/utils';

import { buttonVariants } from './button-variants';

interface Props {
  current: number;
  total: number;
  prev?: string | undefined;
  next?: string | undefined;
  /** Link labels; chronological lists use "Newer" and "Older". */
  labels?: [string, string];
  /** Accessible name of the navigation landmark. */
  label?: string;
  /** The position text; translated callers pass `t('pagination.page', { current, total })`. */
  pageLabel?: string;
  class?: string;
}

const {
  current,
  total,
  prev,
  next,
  labels = ['Previous', 'Next'],
  label = 'Pagination',
  pageLabel = `Page ${current} of ${total}`,
  class: className,
} = Astro.props;
---

{total > 1 && (
  <nav aria-label={label} class={cn('flex items-center justify-between gap-4', className)}>
    {prev ? (
      <a href={prev} rel="prev" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
        <Icon name="lucide:arrow-left" aria-hidden="true" />
        {labels[0]}
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
    <p class="text-sm text-muted-foreground">{pageLabel}</p>
    {next ? (
      <a href={next} rel="next" class={buttonVariants({ variant: 'outline', size: 'sm' })}>
        {labels[1]}
        <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    ) : (
      <span aria-hidden="true" />
    )}
  </nav>
)}
