---
import type { HTMLAttributes } from 'astro/types';

import { initials } from '@/lib/initials';
import { cn } from '@/lib/utils';

/**
 * A user's avatar: the image they set on the dashboard, or their initials on a neutral disc.
 * Decorative by default (the name is always printed next to it); pass `alt` when it is not.
 */
interface Props extends HTMLAttributes<'span'> {
  name: string | null | undefined;
  image?: string | null | undefined;
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
  class?: string;
}

const { name, image, size = 'md', alt = '', class: className, ...rest } = Astro.props;
const sizes = { sm: 'size-6 text-[10px]', md: 'size-9 text-xs', lg: 'size-16 text-lg' } as const;
const classes = cn(
  'inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted font-semibold text-muted-foreground select-none',
  sizes[size],
  className,
);
---

{image ? (
  <img
    src={image}
    alt={alt}
    class={cn(classes, 'object-cover')}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
    {...(rest as HTMLAttributes<'img'>)}
  />
) : (
  <span class={classes} aria-hidden={alt ? undefined : 'true'} data-initials {...rest}>
    {initials(name)}
  </span>
)}
