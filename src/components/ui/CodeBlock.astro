---
import { Code } from 'astro:components';
import type { BundledLanguage } from 'shiki';

import { cn } from '@/lib/utils';

/**
 * Syntax-highlighted code with an optional title bar, for use in .astro pages. A copy button
 * is rendered hidden and revealed by the processed script below, so it only exists when it
 * can work; with a title it sits in the title bar, otherwise over the top-right corner.
 */
interface Props {
  code: string;
  lang?: BundledLanguage | 'text';
  title?: string;
  wrap?: boolean;
  class?: string;
  /** Labels of the copy button; translated pages pass the `code.*` strings. */
  copyLabels?: { copy: string; copied: string; failed: string };
}

const {
  code,
  lang = 'text',
  title,
  wrap = false,
  class: className,
  copyLabels = { copy: 'Copy', copied: 'Copied', failed: 'Copy failed' },
} = Astro.props;
---

<figure
  class={cn(
    'code-block not-prose group relative my-6 overflow-hidden rounded-lg border bg-code text-sm',
    className,
  )}
>
  {title ? (
    <figcaption class="flex items-center justify-between gap-2 border-b px-4 py-2 font-mono text-xs text-muted-foreground">
      <span>{title}</span>
      <button
        type="button"
        hidden
        data-copy-code
        data-copied-label={copyLabels.copied}
        data-copy-failed-label={copyLabels.failed}
        aria-live="polite"
        class="rounded-md border bg-background/80 px-2 py-1 font-sans text-xs text-muted-foreground hover:text-foreground"
      >
        {copyLabels.copy}
      </button>
    </figcaption>
  ) : (
    <button
      type="button"
      hidden
      data-copy-code
      data-copied-label={copyLabels.copied}
      data-copy-failed-label={copyLabels.failed}
      aria-live="polite"
      class="absolute top-2 right-2 rounded-md border bg-background/80 px-2 py-1 text-xs text-muted-foreground opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 focus-visible:opacity-100 hover:text-foreground"
    >
      {copyLabels.copy}
    </button>
  )}
  <Code
    code={code}
    lang={lang}
    themes={{ light: 'github-light', dark: 'github-dark' }}
    defaultColor={false}
    wrap={wrap}
  />
</figure>

<script>
  import { bindCopyButton, copyLabelsOf } from './copy-code';

  document.querySelectorAll<HTMLElement>('figure.code-block').forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>('[data-copy-code]');
    const pre = figure.querySelector('pre');
    if (!button || !pre) return;
    button.hidden = false;
    // The visible text is the "copy" label; the other two come from the data attributes.
    bindCopyButton(button, pre, { ...copyLabelsOf(button), copy: button.textContent ?? 'Copy' });
  });
</script>
