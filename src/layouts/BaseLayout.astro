---
import { PUBLIC_ANALYTICS } from 'astro:env/client';

import Analytics from '@vercel/analytics/astro';

import Head, { type Props as HeadProps } from '@/components/seo/Head.astro';
import Footer from '@/components/site/Footer.astro';
import Header from '@/components/site/Header.astro';
import BackToTop from '@/components/ui/BackToTop.astro';
import SkipLink from '@/components/ui/SkipLink.astro';
import { resolveLocale } from '@/i18n';
import { cn } from '@/lib/utils';

import '@/styles/global.css';

interface Props extends HeadProps {
  /** Extra classes for <main>. */
  class?: string;
  /** Hide the global footer (e.g. auth pages). */
  hideFooter?: boolean;
  /** Include this page in the Pagefind search index (default true). */
  searchable?: boolean;
}

const { class: className, hideFooter = false, searchable = true, ...head } = Astro.props;
// Pages under src/pages/<locale>/ render in that locale (Astro reads it from the path); the
// hreflang links come from the `alternates` a translated page passes (none while English only).
const locale = resolveLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head {...head} locale={locale} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink />
    <Header />
    {/* tabindex="-1" lets the skip link and the back-to-top button move focus here. */}
    <main
      id="main"
      tabindex="-1"
      class={cn('flex-1 outline-none', className)}
      data-pagefind-body={searchable ? '' : undefined}
    >
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <BackToTop />
    {PUBLIC_ANALYTICS === 'vercel' && <Analytics />}
  </body>
</html>
