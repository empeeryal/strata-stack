---
import { Icon } from 'astro-icon/components';

import Alert from '@/components/ui/Alert.astro';
import { noticeMessage } from '@/lib/admin-page';

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  /** Error message from a failed admin action. */
  error?: string | null;
}

const { title, description = 'Administration', error = null } = Astro.props;
const pathname = Astro.url.pathname;
// Confirmation after a successful action (POST → redirect → GET with `?notice=<key>`);
// only known keys render, so the query string cannot inject text.
const notice = noticeMessage(Astro.url.searchParams.get('notice'));

const links = [
  { href: '/admin', label: 'Overview', icon: 'lucide:layout-dashboard' },
  { href: '/admin/messages', label: 'Messages', icon: 'lucide:inbox' },
  { href: '/admin/subscribers', label: 'Subscribers', icon: 'lucide:mail' },
  { href: '/admin/users', label: 'Users', icon: 'lucide:users' },
  { href: '/admin/audit', label: 'Audit log', icon: 'lucide:scroll-text' },
];
const isActive = (href: string) =>
  href === '/admin' ? pathname === '/admin' : pathname === href || pathname.startsWith(`${href}/`);
---

<BaseLayout
  title={`${title} · Admin`}
  description={description}
  noindex
  searchable={false}
  class="container py-10"
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold text-primary">Admin</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight">{title}</h1>
    </div>
    <nav aria-label="Admin sections" class="flex flex-wrap gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class="inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground"
        >
          <Icon name={link.icon} class="size-4" aria-hidden="true" />
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  {error && <Alert class="mt-6">{error}</Alert>}
  {notice && (
    <Alert variant="success" class="mt-6" data-admin-notice>
      {notice}
    </Alert>
  )}

  <div class="mt-8">
    <slot />
  </div>
</BaseLayout>

<script>
  // Confirmation prompts for destructive forms, free-text prompts whose answer goes into the
  // form's `[data-prompt-field]` input (the ban reason), and one submission per form: the second
  // POST of a double click would act on a row the first one already changed and come back as an
  // error. Cancelling a prompt aborts the submission. Inline `onsubmit` handlers are blocked by
  // the CSP, so the behaviour is attached here from a processed script.
  const forms = document.querySelectorAll<HTMLFormElement>('form');

  function submitButtons(form: HTMLFormElement) {
    return form.querySelectorAll<HTMLButtonElement>('button:not([type]), button[type="submit"]');
  }

  forms.forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (form.dataset.submitting) {
        event.preventDefault();
        return;
      }
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) {
        event.preventDefault();
        return;
      }
      if (form.dataset.prompt) {
        const answer = window.prompt(form.dataset.prompt, '');
        if (answer === null) {
          event.preventDefault();
          return;
        }
        const field = form.querySelector<HTMLInputElement>('[data-prompt-field]');
        if (field) field.value = answer.trim();
      }
      form.dataset.submitting = 'true';
      // Disabled on the next tick, so the clicked button's own name and value still travel
      // with the request.
      setTimeout(() => {
        submitButtons(form).forEach((button) => {
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
        });
      });
    });
  });

  // A page restored from the back/forward cache keeps the DOM of the submission; make the forms
  // usable again.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    forms.forEach((form) => {
      delete form.dataset.submitting;
      submitButtons(form).forEach((button) => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      });
    });
  });
</script>
