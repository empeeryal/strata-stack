{
  "name": "strata-stack",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Strata, the layered Astro 7 stack: React 19, Motion, Tailwind 4, Better Auth, Drizzle + libSQL, MDX docs and blog, SEO, CSP, tests. Deploys to Vercel, Cloudflare, Netlify and Node.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cloudflare": "cross-env DEPLOY_TARGET=cloudflare astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build",
    "build:node": "cross-env DEPLOY_TARGET=node astro build",
    "build:vercel": "cross-env DEPLOY_TARGET=vercel astro build",
    "build:netlify": "cross-env DEPLOY_TARGET=netlify astro build",
    "build:cloudflare": "cross-env DEPLOY_TARGET=cloudflare astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/reset-db.ts",
    "db:prune": "node --env-file-if-exists=.env scripts/prune-messages.ts",
    "admin:promote": "node --env-file-if-exists=.env scripts/promote-admin.ts",
    "auth:generate": "auth generate --adapter drizzle --dialect sqlite --output src/db/schema/auth.ts -y",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "clean": "node scripts/clean.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@libsql/client": "^0.18.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/netlify": "^8.2.6",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/simple-icons": "^1.2.96",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "astro-icon": "^1.2.0",
    "astro-pagefind": "^2.0.1",
    "auth": "^1.7.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "satori": "^0.33.4",
    "schema-dts": "^2.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx,json,jsonc,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
